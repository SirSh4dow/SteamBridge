    <Compile Include="../../src/SteamBridge/Core/CollectionsManager.cs" Link="Core/CollectionsManager.cs" />
    <Compile Include="../../src/SteamBridge/Core/SteamArtManager.cs" Link="Core/SteamArtManager.cs" />
    <Compile Include="../../src/SteamBridge/Core/SteamLocator.cs" Link="Core/SteamLocator.cs" />
    <Compile Include="../../src/SteamBridge/Core/VdfTextParser.cs" Link="Core/VdfTextParser.cs" />
    <Compile Include="../../src/SteamBridge/Models/DataModels.cs" Link="Models/DataModels.cs" />
  </ItemGroup>
</Project>
