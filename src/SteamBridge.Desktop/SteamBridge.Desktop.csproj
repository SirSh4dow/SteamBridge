<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SteamBridge.Desktop</AssemblyName>
    <RootNamespace>SteamBridge.Desktop</RootNamespace>
    <ApplicationManifest>../SteamBridge/app.manifest</ApplicationManifest>
    <Version>3.0.0</Version>
    <Product>SteamBridge</Product>
    <Description>Biblioteca gamer nativa para Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SteamBridge/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../SteamBridge/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../SteamBridge/Scanners/*.cs" Link="Scanners/%(Filename)%(Extension)" />
    <Content Include="../../launcher/bin/SteamBridgeLauncher.exe" Link="SteamBridgeLauncher.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
