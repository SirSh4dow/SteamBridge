<Window x:Class="SteamBridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamBridge — Sua biblioteca, conectada"
        Width="1440" Height="940" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#090A10"
        Foreground="#F4F1EA"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Background="#090A10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Background="{StaticResource SidebarBrush}" BorderBrush="#1C1F2C" BorderThickness="0,0,1,0">
      <Grid Margin="18,26,18,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="8,0,0,36">
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="12" Margin="0,0,12,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#C4B0FF" Offset="0"/>
                  <GradientStop Color="#6D4EC4" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Path Data="M 8,26 L 8,15 L 15,8 L 22,15 L 22,26 M 15,8 L 28,8 L 28,18 L 22,26 M 8,15 L 22,15"
                    Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18" Stretch="Uniform"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="SteamBridge" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="18"/>
              <TextBlock Text="Biblioteca nativa" FontSize="11" Foreground="#7E8498" Margin="0,1,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" IsEnabled="{Binding Ready}">
          <TextBlock Text="NAVEGAR" Style="{StaticResource Eyebrow}" Margin="16,0,0,10"/>
          <RadioButton x:Name="NavLibrary" AutomationProperties.Name="Minha biblioteca" GroupName="Nav" Style="{StaticResource Navigation}" IsChecked="True" Tag="Library" Checked="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="15" Margin="0,0,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              <TextBlock Text="Minha biblioteca" FontSize="13.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavArt" AutomationProperties.Name="Artes e capas" GroupName="Nav" Style="{StaticResource Navigation}" Tag="Art" Checked="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;" FontSize="15" Margin="0,0,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              <TextBlock Text="Artes e capas" FontSize="13.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavCollections" AutomationProperties.Name="Coleções" GroupName="Nav" Style="{StaticResource Navigation}" Tag="Collections" Checked="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="15" Margin="0,0,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              <TextBlock Text="Coleções" FontSize="13.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </StackPanel>
          </RadioButton>
          <Border Height="1" Background="#222636" Margin="14,18"/>
          <RadioButton x:Name="NavSettings" AutomationProperties.Name="Configurações" GroupName="Nav" Style="{StaticResource Navigation}" Tag="Settings" Checked="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" Margin="0,0,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              <TextBlock Text="Configurações" FontSize="13.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <Border Grid.Row="3" Background="#141722" CornerRadius="14" BorderBrush="#2C2840" BorderThickness="1" Padding="14,13">
          <StackPanel>
            <TextBlock Text="Um só lugar" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="Epic, Xbox e jogos locais entram no Steam sem sair do Windows." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
            <TextBlock Text="v3.0  ·  Windows" FontSize="10" Foreground="#6A7086" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="72"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border BorderBrush="#1C2030" BorderThickness="0,0,0,1" Padding="32,0,28,0">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="STEAMBRIDGE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Central de jogos" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#12141C" CornerRadius="8" BorderBrush="#2A2E3C" BorderThickness="1" Padding="12,6" Margin="0,0,14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{Binding SteamStatusBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding SteamStatus}" Foreground="#C8CDDC" FontSize="12" VerticalAlignment="Center"/>
              <Button x:Name="SteamButton" Content="{Binding SteamAction}" Click="ToggleSteam_Click" Padding="10,4" Margin="12,0,0,0" FontSize="12" IsEnabled="{Binding Ready}"/>
            </StackPanel>
          </Border>
          <ComboBox Grid.Column="2" x:Name="AccountCombo" Width="220" VerticalAlignment="Center"
                    ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" SelectionChanged="AccountChanged"
                    ToolTip="Conta Steam que receberá as alterações" AutomationProperties.Name="Conta Steam" IsEnabled="{Binding Ready}"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="32,22,28,12" IsEnabled="{Binding Ready}">
        <Grid x:Name="LibraryPage">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Minha biblioteca" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Seus jogos. Suas plataformas. Um único lugar." Style="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Adicionar jogo" Click="AddGame_Click" Margin="0,0,10,0" ToolTip="Escolher um .exe, .cmd ou .bat"/>
              <Button Content="Escanear jogos" Click="Scan_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
              <Border CornerRadius="18" BorderBrush="#3A2E58" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,18" Background="{StaticResource HeroFill}">
                <Grid Height="156">
                  <Canvas HorizontalAlignment="Right" Width="420" IsHitTestVisible="False" Opacity="0.9">
                    <Ellipse Width="220" Height="220" Stroke="#3A3358" StrokeThickness="1" Canvas.Left="160" Canvas.Top="-40"/>
                    <Ellipse Width="300" Height="300" Stroke="#2A3148" StrokeThickness="1" Canvas.Left="120" Canvas.Top="-80"/>
                    <Path Data="M 210,120 L 210,70 L 258,26 L 306,70 L 306,120 M 258,26 L 354,26 L 354,74 L 306,120 M 210,70 L 306,70"
                          Stroke="#C4B0FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.85"/>
                    <Ellipse Width="7" Height="7" Fill="#E4C27A" Canvas.Left="150" Canvas.Top="128"/>
                  </Canvas>
                  <StackPanel Margin="28,22" VerticalAlignment="Center">
                    <TextBlock Text="SEM FRONTEIRAS ENTRE PLATAFORMAS" Style="{StaticResource Eyebrow}" Foreground="#CDBAF5"/>
                    <TextBlock Text="Seu próximo jogo está aqui." FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,6"/>
                    <TextBlock Text="Conecte suas bibliotecas e dê uma nova cara ao seu Steam." Foreground="#B7B3C8" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <Border Background="#223044" CornerRadius="999" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="STEAM" Foreground="#8FD0F0" FontSize="10" FontWeight="Bold"/></Border>
                      <Border Background="#2A2438" CornerRadius="999" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="EPIC" Foreground="#D5CFEA" FontSize="10" FontWeight="Bold"/></Border>
                      <Border Background="#1C3328" CornerRadius="999" Padding="8,3" Margin="0,0,6,0"><TextBlock Text="XBOX" Foreground="#8FDEB0" FontSize="10" FontWeight="Bold"/></Border>
                      <Border Background="#2C261C" CornerRadius="999" Padding="8,3"><TextBlock Text="LOCAL" Foreground="#E4C27A" FontSize="10" FontWeight="Bold"/></Border>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                  <StackPanel>
                    <Border Height="3" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="#A78BFA" Margin="0,0,0,10"/>
                    <TextBlock Text="NA BIBLIOTECA" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                  <StackPanel>
                    <Border Height="3" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="#7EC8EA" Margin="0,0,0,10"/>
                    <TextBlock Text="NO STEAM" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding IntegratedCount}" FontSize="28" FontWeight="SemiBold" Foreground="#8FD0F0" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                  <StackPanel>
                    <Border Height="3" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="#C4B0FF" Margin="0,0,0,10"/>
                    <TextBlock Text="PARA INTEGRAR" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding PendingCount}" FontSize="28" FontWeight="SemiBold" Foreground="#CDBAF5" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                  <StackPanel>
                    <Border Height="3" Width="28" HorizontalAlignment="Left" CornerRadius="2" Background="#8FDEB0" Margin="0,0,0,10"/>
                    <TextBlock Text="PLATAFORMAS" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding PlatformCount}" FontSize="28" FontWeight="SemiBold" Foreground="#8FDEB0" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <RadioButton GroupName="Sources" Content="Todos" Tag="all" Style="{StaticResource Filter}" IsChecked="True" Checked="FilterChanged"/>
                  <RadioButton GroupName="Sources" Content="Steam" Tag="steam" Style="{StaticResource Filter}" Checked="FilterChanged"/>
                  <RadioButton GroupName="Sources" Content="Epic" Tag="epic" Style="{StaticResource Filter}" Checked="FilterChanged"/>
                  <RadioButton GroupName="Sources" Content="Xbox" Tag="xbox" Style="{StaticResource Filter}" Checked="FilterChanged"/>
                  <RadioButton GroupName="Sources" Content="Locais" Tag="folder" Style="{StaticResource Filter}" Checked="FilterChanged"/>
                </StackPanel>
                <Grid Grid.Column="1">
                  <TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Buscar jogos pelo nome" AutomationProperties.Name="Buscar jogos" VerticalAlignment="Center"/>
                  <TextBlock Text="Buscar na biblioteca" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#6E748C" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Grid>
              <TextBlock Text="{Binding ResultsLabel}" Style="{StaticResource Muted}" FontSize="11" Margin="2,2,0,14"/>

              <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Card}" Padding="36" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                  <TextBlock Text="Sua próxima conexão começa aqui" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Nenhum jogo neste filtro. Escaneie as plataformas ou adicione uma pasta nas configurações." Style="{StaticResource Muted}" Margin="0,10" TextAlignment="Center"/>
                  <Button Content="Escanear bibliotecas" Click="Scan_Click" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding VisibleGames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource GameCard}" ToolTip="{Binding Location}">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="248"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="{Binding CoverBrush}">
                          <Grid>
                            <TextBlock Text="{Binding Initial}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="92" FontWeight="Bold" Foreground="#22FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                            <Border VerticalAlignment="Bottom" Height="88">
                              <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                  <GradientStop Color="#0012141C" Offset="0"/>
                                  <GradientStop Color="#F012141C" Offset="1"/>
                                </LinearGradientBrush>
                              </Border.Background>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#E0101218" CornerRadius="6" Padding="7,3">
                              <TextBlock Text="{Binding Badge}" Foreground="{Binding SourceBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <CheckBox IsChecked="{Binding Selected}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" ToolTip="Selecionar jogo" AutomationProperties.Name="{Binding Title}"/>
                            <Button Content="Detalhes" Style="{StaticResource ChipButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="GameDetails_Click"/>
                          </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="12,10,12,12">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                          <TextBlock Text="{Binding Subtitle}" Foreground="#8E93A6" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Content="Carregar mais jogos" Click="LoadMore_Click" Visibility="{Binding HasMore, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" Background="#141722" CornerRadius="14" BorderBrush="#3A3358" BorderThickness="1" Padding="14,10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SelectPending" Content="Selecionar pendentes" Click="SelectPending_Click"/>
                <TextBlock Text="{Binding SelectionLabel}" Foreground="#CDBAF5" Margin="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Limpar" Click="ClearSelection_Click" Padding="14,9" Margin="0,0,8,0"/>
                <Button Content="Integrar ao Steam" Click="Apply_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasImportSelection}"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="ArtPage" Visibility="Collapsed">
          <Grid x:Name="ShelfView">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="2,0,0,16">
              <TextBlock Text="SUAS CAPAS" Style="{StaticResource Eyebrow}"/>
              <TextBlock Text="Escolha um jogo" Style="{StaticResource SectionTitle}" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ArtGames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Click="ShelfPick_Click" Margin="0,0,16,18" Cursor="Hand" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Title}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <StackPanel Width="168">
                            <Border x:Name="Frame" Height="240" CornerRadius="16" BorderThickness="1" BorderBrush="#2A2E3C" ClipToBounds="True" Background="{Binding CoverBrush}">
                              <Grid>
                                <TextBlock Text="{Binding Initial}" FontSize="32" FontWeight="SemiBold" Foreground="#F4F1EA" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding Title}" Margin="4,10,4,0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#F4F1EA"/>
                          </StackPanel>
                          <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsShelfFocus}" Value="True">
                              <Setter TargetName="Frame" Property="BorderBrush" Value="#A78BFA"/>
                              <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Frame" Property="BorderBrush" Value="#8E79D6"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <Grid x:Name="CoverStudio" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Content="←  Suas capas" Click="StudioBack_Click" Padding="14,8" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StudioTitle}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StudioCaption}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="{Binding ArtPreviewWidth}" Height="{Binding ArtPreviewHeight}" VerticalAlignment="Top" Background="#12141C" BorderBrush="#2A2E3C" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
                <Grid>
                  <TextBlock Text="Sem capa" Foreground="#5C6378" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image Source="{Binding ArtPreview}" Stretch="Uniform" Margin="12"/>
                </Grid>
              </Border>
              <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                  <RadioButton x:Name="ArtFormatPortrait" Content="Vertical" Tag="portrait" GroupName="ArtFormat" Style="{StaticResource Filter}" IsChecked="True" Click="ArtFormat_Click"/>
                  <RadioButton x:Name="ArtFormatWide" Content="Horizontal" Tag="wide" GroupName="ArtFormat" Style="{StaticResource Filter}" Click="ArtFormat_Click"/>
                  <RadioButton x:Name="ArtFormatHero" Content="Banner" Tag="hero" GroupName="ArtFormat" Style="{StaticResource Filter}" Click="ArtFormat_Click"/>
                  <RadioButton x:Name="ArtFormatLogo" Content="Logo" Tag="logo" GroupName="ArtFormat" Style="{StaticResource Filter}" Click="ArtFormat_Click"/>
                  <RadioButton x:Name="ArtFormatIcon" Content="Ícone" Tag="icon" GroupName="ArtFormat" Style="{StaticResource Filter}" Click="ArtFormat_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <Grid>
                    <TextBlock x:Name="ArtChoicesEmpty" Text="Buscando capas…" Style="{StaticResource Muted}" Margin="4,8,0,0"/>
                    <ItemsControl ItemsSource="{Binding ArtworkOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Click="SelectArt_Click" Margin="0,0,14,14" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Card" Width="{Binding ArtCardWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding ArtCardHeight, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="10" BorderThickness="2" BorderBrush="#262A38" ClipToBounds="True" Background="#12141C">
                                  <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#A78BFA"/>
                                  </DataTrigger>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#8E79D6"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Button.Template>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </ScrollViewer>
              </DockPanel>
            </Grid>

            <Border Grid.Row="2" Margin="0,16,0,0" Background="#12141C" BorderBrush="#2A2E3C" BorderThickness="1" CornerRadius="16" Padding="14,12">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Aplicar capa" Click="UseArt_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasArtSelection}" MinWidth="150"/>
                <Button DockPanel.Dock="Right" Content="Importar" Click="ImportArt_Click" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="Buscar de novo" Click="SearchArt_Click" Margin="0,0,8,0"/>
                <TextBox x:Name="ArtSearchName" DockPanel.Dock="Left" Width="240" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Nome usado na busca" AutomationProperties.Name="Nome para buscar capas" KeyDown="ArtSearch_KeyDown"/>
                <ComboBox x:Name="ArtMatchCombo" DockPanel.Dock="Left" Width="200" VerticalAlignment="Center" Margin="0,0,12,0" DisplayMemberPath="Name" SelectionChanged="ArtMatch_Changed" Visibility="Collapsed" AutomationProperties.Name="Versão encontrada"/>
                <TextBlock Text="{Binding ArtStatus}" VerticalAlignment="Center" Foreground="#A7ADBF" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Border>
          </Grid>

          <ComboBox x:Name="ArtGameCombo" ItemsSource="{Binding ArtGames}" DisplayMemberPath="Title" SelectionChanged="ArtSelectionChanged" Width="0" Height="0" Opacity="0" IsHitTestVisible="False"/>
          <TextBox x:Name="ArtGameId" Width="0" Height="0" Opacity="0"/>
        </Grid>

        <Grid x:Name="CollectionsPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Organize do seu jeito" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Coleções do Steam, com jogos nativos e atalhos na mesma lista." Style="{StaticResource Muted}"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="SUAS COLEÇÕES" Style="{StaticResource Eyebrow}" Margin="2,0,0,12"/>
                  <TextBox x:Name="NewCollectionName" ToolTip="Nome da nova coleção" AutomationProperties.Name="Nome da nova coleção"/>
                  <Button Content="Criar coleção" Click="CreateCollection_Click" Margin="0,10,0,16" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
                <ListBox x:Name="CollectionsList" ItemsSource="{Binding Collections}" DisplayMemberPath="Name" SelectionChanged="CollectionChanged"/>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="{Binding CollectionHeading}" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding CollectionDescription}" Style="{StaticResource Muted}" Margin="0,8,0,16"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Content="Salvar seleção" Click="SaveCollection_Click" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="Excluir coleção" Click="DeleteCollection_Click" Margin="10,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="CollectionGames" SelectionMode="Multiple" ItemsSource="{Binding IntegratedGames}" DisplayMemberPath="Title"/>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Ajuste o seu setup" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Suas fontes, integrações e opções de segurança." Style="{StaticResource Muted}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Conexão com o Steam" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Deixe em branco para detectar automaticamente. Selecione a pasta que contém steam.exe." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Procurar" Click="BrowseSteam_Click" Margin="10,0,0,0"/>
                  <TextBox x:Name="SteamPathBox" AutomationProperties.Name="Pasta do Steam"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Pastas de jogos locais" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Adicione somente pastas de jogos, não a raiz inteira do disco. A busca é limitada a três níveis." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                <ListBox x:Name="FoldersList" ItemsSource="{Binding Folders}" Height="120"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Adicionar pasta" Click="AddFolder_Click"/>
                  <Button Content="Remover da lista" Click="RemoveFolder_Click" Margin="10,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="SteamGridDB" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Chave de API pessoal para buscar artes. Opcional: imagens locais não precisam de chave. Fica no perfil do Windows; não compartilhe o arquivo de configuração." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="Chave SteamGridDB"/>
              </StackPanel>
            </Border>

            <Button Content="Salvar configurações" Click="SaveSettings_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,2,0,18"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Você no controle" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="O Steam precisa estar fechado antes de gravar alterações. Backups são criados antes de substituir arquivos." Style="{StaticResource Muted}" Margin="0,8,0,14"/>
                <WrapPanel>
                  <Button Content="Abrir pasta de backups" Click="OpenBackups_Click" Margin="0,0,8,8"/>
                  <Button Content="Restaurar atalhos" Click="RestoreShortcuts_Click" Margin="0,0,8,8"/>
                  <Button Content="Remover atalhos selecionados" Click="RemoveShortcuts_Click" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock Text="A remoção usa a seleção da biblioteca e nunca desinstala jogos. Coleções dinâmicas são somente leitura." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Background="#0C0D14" BorderBrush="#1C2030" BorderThickness="0,1,0,0" Padding="32,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Status}" Foreground="#9AA0B4" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
          <TextBlock Grid.Column="1" Text="Local  ·  sem navegador" Foreground="#5E6478" FontSize="11" Margin="20,0,0,0"/>
        </Grid>
      </Border>
      <ProgressBar Grid.Row="0" Height="3" VerticalAlignment="Bottom" IsIndeterminate="True" Foreground="#A78BFA" Background="Transparent" BorderThickness="0" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
    </Grid>
  </Grid>
</Window>
